{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tobianahillel-afk/Bot-crypto/engineering/WORK_ITEM_SCHEMA.json",
  "title": "Crypto Quant Bot Work Item Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "title",
    "status",
    "objective",
    "depends_on",
    "allowed_paths",
    "forbidden_scope",
    "tasks",
    "done_when"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "bootstrap_work_item",
        "engineering_work_item",
        "audit_work_item",
        "business_work_unit"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]*(?:[.-][A-Z0-9_-]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "IN_PROGRESS",
        "BLOCKED",
        "DONE"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PLANNED",
              "IN_PROGRESS",
              "BLOCKED",
              "DONE"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "done_when": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
