  "contracts": {
    "required_invariants": [
      "candidate lifecycle states and allowed transitions are finite explicit and machine-readable",
      "terminal certified rejected and withdrawn states cannot silently return to mutable validation states",
      "certification readiness requires declared evidence prerequisites and cannot be inferred from status text alone",
      "stale or mismatched evidence forces the candidate out of certification-ready state",
      "withdrawal and rejection are distinct explicit outcomes",
      "lifecycle policy does not unlock business development or runtime capability",
      "all validation is deterministic standard-library and zero-cost"
    ],
    "acceptance_criteria": [
      "valid forward lifecycle transition sequences pass",
      "skipped certification prerequisites fail",
      "CERTIFIED without exact-head evidence prerequisite fails",
      "terminal-state resurrection fails",
      "stale evidence invalidates readiness",
      "withdrawal remains distinct from rejection",
      "unknown states transitions or evidence classes fail closed",
      "validator and adversarial selftests require no network or third-party dependency"
    ]
  },
