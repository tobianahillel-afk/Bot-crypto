  "contracts": {
    "required_invariants": [
      "classification is deterministic and standard-library only",
      "one path may receive multiple labels",
      "unknown repository paths receive a conservative UNKNOWN_REQUIRES_REVIEW label",
      "risk execution OMS EMS paths receive a critical label",
      "mixed docs and production changes are never classified as documentation-only",
      "classifier output does not itself authorize skipping validation"
    ],
    "acceptance_criteria": [
      "docs-only paths classify as DOC_ONLY without production labels",
      "workflow changes include CI_WORKFLOW",
      "contract/schema paths include CONTRACT_SCHEMA",
      "security-sensitive paths include SECURITY",
      "risk/execution paths include RISK_EXECUTION_CRITICAL",
      "mixed diffs retain all relevant labels and are not DOC_ONLY",
      "unknown paths fail conservatively via UNKNOWN_REQUIRES_REVIEW"
    ]
  },
