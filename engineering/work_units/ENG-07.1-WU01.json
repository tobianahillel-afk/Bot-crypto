  "contracts": {
    "required_invariants": [
      "planner is pure deterministic and read-only",
      "only historical certified business lots 0 through 44 are eligible for batching",
      "Lot45 suspended candidate and Lot46+ are excluded",
      "every eligible lot appears exactly once in one batch",
      "batch ordering follows ascending historical lot order",
      "batch size is bounded by both maximum lot count and cumulative complexity budget",
      "a single lot above the normal batch budget is isolated rather than dropped",
      "complexity inputs are explicit integers and unknown/malformed inputs fail closed",
      "no batching decision mutates historical evidence audit state business state or runtime authority"
    ],
    "acceptance_criteria": [
      "stable identical input produces byte-equivalent plan identity",
      "Lots 0-44 are covered exactly once with no gaps or duplicates",
      "Lot45 and later lots cannot enter the plan",
      "higher-complexity lots cause earlier batch splits",
      "oversized single lot forms a one-lot isolated batch with explicit reason",
      "negative duplicate missing or out-of-range lot descriptors fail closed",
      "batch plan records deterministic per-batch and whole-plan SHA-256 identities"
    ]
  },
