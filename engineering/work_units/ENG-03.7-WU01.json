    "acceptance_criteria": [
      "identical exact inputs produce identical proof key",
      "changing one bound input byte changes proof key",
      "changing policy implementation parameters or environment changes proof key",
      "timestamps/source-head metadata do not affect proof key for explicitly reusable subjects",
      "failed evidence cannot be reused",
      "T4 subject reuse is rejected regardless of matching key",
      "path traversal symlink and missing-file bindings are rejected",
      "proof JSON tampering is detected"
    ]
