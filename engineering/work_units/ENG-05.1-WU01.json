  "contracts": {
    "required_invariants": [
      "config/governance/project_state.json is the sole mutable status source for generated blocks",
      "generated output contains no wall-clock timestamp or network-derived value",
      "README and AGENTS each contain exactly one bounded generated-current-status block",
      "engineering/CURRENT_STATUS.md is fully generated and contains an explicit do-not-edit notice",
      "renderer update mode is deterministic and idempotent",
      "renderer check mode performs no writes and fails on any stale or malformed generated block",
      "generated content preserves business PAUSED state Lot45 suspended candidate Lot46 LOCKED and runtime safety flags exactly"
    ],
    "acceptance_criteria": [
      "two consecutive update runs produce byte-identical files",
      "check mode passes immediately after update",
      "changing canonical state in an isolated fixture changes rendered status deterministically",
      "stale README or AGENTS block fails check mode",
      "duplicate or missing block markers fail closed",
      "no timestamps network calls external packages or paid services are required",
      "documentation-only generation never triggers execution-domain validation"
    ]
  },
