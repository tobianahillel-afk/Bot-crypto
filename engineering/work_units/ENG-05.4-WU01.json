  "contracts": {
    "required_invariants": [
      "config/governance/project_state.json is the only current authorization state consumed by the handoff validator",
      "handoff explicitly declares itself RESUME_HINT_NOT_AUTHORITY",
      "handoff active checkpoint exactly matches the single active AWU and its scope base risk and complexity",
      "handoff external Git observation exactly matches canonical recorded observations",
      "handoff safety snapshot blockers findings and stop conditions exactly match canonical state",
      "handoff recent_completed and validation_evidence are bounded",
      "at least one PASS evidence record is bound to the active AWU scope_base_sha",
      "engineering/STATE.json remains compatibility-only and is not accepted as handoff authority",
      "cold-start validates the handoff against permanent state",
      "validation is offline standard-library zero-cost"
    ],
    "acceptance_criteria": [
      "legacy bootstrap_handoff schema_version 1 is rejected",
      "valid V2 handoff passes",
      "stale active task or next_engineering fails closed",
      "stale AWU id scope base risk or complexity fails closed",
      "stale main or Lot45 head observation fails closed",
      "bridge authority substitution fails closed",
      "malformed or unbound validation evidence fails closed",
      "stop-condition or safety drift fails closed",
      "recent history remains bounded to at most 8 entries",
      "bootstrap runs handoff self-check probes"
    ]
  },
