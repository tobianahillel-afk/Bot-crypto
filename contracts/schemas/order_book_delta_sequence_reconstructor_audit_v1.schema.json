{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order_book_delta_sequence_reconstructor_audit_v1.schema.json",
  "title": "OrderBookDeltaSequenceReconstructorAuditV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code_commit",
    "config_checksum",
    "entry_gate_checksum",
    "lot38_state_checksum",
    "lot38_snapshot_checksum",
    "delta_fixture_checksum",
    "state_output_checksum",
    "reconstructed_book_checksum",
    "sequence_gap_event_checksum",
    "validation_state",
    "synchronization_state",
    "safety",
    "audit_checksum"
  ],
  "properties": {
    "schema_version": {"const": "order-book-delta-sequence-reconstructor-audit-v1"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "config_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry_gate_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot38_state_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot38_snapshot_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "delta_fixture_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_output_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reconstructed_book_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sequence_gap_event_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_state": {"const": "VALIDATED_OFFLINE_DELTA_SEQUENCE_RECONSTRUCTION_ONLY"},
    "synchronization_state": {"const": "SYNCED"},
    "safety": {"type": "object"},
    "audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
