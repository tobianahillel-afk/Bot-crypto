{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "closure_manifest_v1.schema.json",
  "title": "ClosureManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version_id", "lots_included", "closure_status", "v3_closed", "post_merge_audit_required", "human_review_required", "next_lot", "next_lot_status", "reason_codes", "manifest_checksum"],
  "properties": {
    "schema_version": {"const": "closure-manifest-v1"},
    "version_id": {"const": "V3_MARKET_DATA_GOVERNANCE"},
    "lots_included": {"const": [31, 32, 33, 34, 35, 36]},
    "closure_status": {"enum": ["CANDIDATE_VALIDATED_AWAITING_POST_MERGE_AUDIT", "BLOCKED"]},
    "v3_closed": {"const": false},
    "post_merge_audit_required": {"const": true},
    "human_review_required": {"const": true},
    "next_lot": {"const": 37},
    "next_lot_status": {"const": "PLANNED_LOCKED"},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "manifest_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
