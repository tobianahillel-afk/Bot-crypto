{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant-bot.local/schemas/timestamp_clock_timezone_governance_state_v1.schema.json",
  "title": "TimestampClockTimezoneGovernanceStateV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_context", "lineage", "event_time", "available_at", "generated_at",
    "validation_state", "canonical_envelopes", "clock_health", "metrics", "reason_codes",
    "analysis_only", "used_for_decision", "external_connectivity_allowed",
    "network_ingestion_allowed", "real_credentials_allowed", "signal_generation_allowed",
    "risk_approval_allowed", "order_routing_allowed", "trade_allowed", "execution_allowed",
    "approved_size", "output_checksum"
  ],
  "properties": {
    "schema_version": {"const": "timestamp-clock-timezone-governance-state-v1"},
    "run_context": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "run_id", "runtime_mode", "config_version", "code_commit", "correlation_id"],
      "properties": {
        "schema_version": {"const": "run-context-v1"},
        "run_id": {"type": "string"},
        "runtime_mode": {"const": "DATA_GOVERNANCE_ONLY"},
        "config_version": {"type": "string"},
        "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "correlation_id": {"type": "string"}
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "lineage_id", "instrument_registry_path", "instrument_registry_checksum", "lot32_state_checksum", "lot32_audit_checksum", "available_at"],
      "properties": {
        "schema_version": {"const": "lot33-lineage-envelope-v1"},
        "lineage_id": {"type": "string"},
        "instrument_registry_path": {"const": "data/audit/instrument_registry_lot32.json"},
        "instrument_registry_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lot32_state_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lot32_audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "available_at": {"type": "string", "format": "date-time"}
      }
    },
    "event_time": {"type": "string", "format": "date-time"},
    "available_at": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "validation_state": {"const": "VALIDATED_TEMPORAL_ONLY"},
    "canonical_envelopes": {"type": "array", "minItems": 1, "items": {"$ref": "canonical_time_envelope_v1.schema.json"}},
    "clock_health": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "max_clock_drift_us", "max_out_of_order_delay_us", "max_total_latency_us", "observed_clock_drift_us", "observed_out_of_order_delay_us", "observed_total_latency_us", "reason_codes"],
      "properties": {
        "schema_version": {"const": "clock-health-state-v1"},
        "status": {"enum": ["HEALTHY", "DEGRADED", "BLOCKED"]},
        "max_clock_drift_us": {"type": "integer", "minimum": 0},
        "max_out_of_order_delay_us": {"type": "integer", "minimum": 0},
        "max_total_latency_us": {"type": "integer", "minimum": 0},
        "observed_clock_drift_us": {"type": "integer", "minimum": 0},
        "observed_out_of_order_delay_us": {"type": "integer", "minimum": 0},
        "observed_total_latency_us": {"type": "integer", "minimum": 0},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "lot_33_records_processed_total", "lot_33_validation_failures_total", "lot_33_out_of_order_records_total", "lot_33_processing_latency_us"],
      "properties": {
        "schema_version": {"const": "lot33-metrics-v1"},
        "lot_33_records_processed_total": {"type": "integer", "minimum": 0},
        "lot_33_validation_failures_total": {"type": "integer", "minimum": 0},
        "lot_33_out_of_order_records_total": {"type": "integer", "minimum": 0},
        "lot_33_processing_latency_us": {"type": "integer", "minimum": 0}
      }
    },
    "reason_codes": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "analysis_only": {"const": true},
    "used_for_decision": {"const": false},
    "external_connectivity_allowed": {"const": false},
    "network_ingestion_allowed": {"const": false},
    "real_credentials_allowed": {"const": false},
    "signal_generation_allowed": {"const": false},
    "risk_approval_allowed": {"const": false},
    "order_routing_allowed": {"const": false},
    "trade_allowed": {"const": false},
    "execution_allowed": {"const": false},
    "approved_size": {"const": 0},
    "output_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
