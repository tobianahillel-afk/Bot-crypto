{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order_flow_delta_cvd_engine_audit_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "order-flow-delta-cvd-engine-audit-v1"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "state_output_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot44_state_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot44_audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot44_confidence_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_state": {"const": "VALIDATED_OFFLINE_ORDER_FLOW_DELTA_CVD_ONLY"},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analysis_only": {"const": true},
        "approved_size": {"const": 0},
        "execution_allowed": {"const": false},
        "external_connectivity_allowed": {"const": false},
        "market_event_publication_allowed": {"const": false},
        "network_ingestion_allowed": {"const": false},
        "order_routing_allowed": {"const": false},
        "participant_behavior_inference_explicitly_labeled": {"const": true},
        "raw_data_mutation_allowed": {"const": false},
        "real_credentials_allowed": {"const": false},
        "risk_approval_allowed": {"const": false},
        "scenario_score_is_signal": {"const": false},
        "signal_generation_allowed": {"const": false},
        "trade_allowed": {"const": false},
        "used_for_decision": {"const": false}
      },
      "required": ["analysis_only", "approved_size", "execution_allowed", "external_connectivity_allowed", "market_event_publication_allowed", "network_ingestion_allowed", "order_routing_allowed", "participant_behavior_inference_explicitly_labeled", "raw_data_mutation_allowed", "real_credentials_allowed", "risk_approval_allowed", "scenario_score_is_signal", "signal_generation_allowed", "trade_allowed", "used_for_decision"]
    },
    "audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["schema_version", "code_commit", "state_output_checksum", "config_checksum", "lot44_state_checksum", "lot44_audit_checksum", "lot44_confidence_checksum", "validation_state", "safety", "audit_checksum"]
}
