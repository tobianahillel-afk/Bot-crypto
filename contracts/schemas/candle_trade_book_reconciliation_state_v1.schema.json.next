{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candle_trade_book_reconciliation_state_v1.schema.json",
  "title": "CandleTradeBookReconciliationStateV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_context", "lineage", "event_time", "available_at", "generated_at",
    "validation_state", "reports", "veto", "metrics", "reason_codes", "analysis_only",
    "used_for_decision", "external_connectivity_allowed", "network_ingestion_allowed",
    "real_credentials_allowed", "market_event_publication_allowed", "raw_data_mutation_allowed",
    "signal_generation_allowed", "risk_approval_allowed", "order_routing_allowed",
    "trade_allowed", "execution_allowed", "approved_size", "output_checksum"
  ],
  "properties": {
    "schema_version": {"const": "candle-trade-book-reconciliation-state-v1"},
    "run_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "runtime_mode", "config_version", "code_commit", "correlation_id"],
      "properties": {
        "schema_version": {"const": "run-context-v1"},
        "run_id": {"type": "string", "minLength": 1},
        "runtime_mode": {"const": "DATA_GOVERNANCE_ONLY"},
        "config_version": {"type": "string", "minLength": 1},
        "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "correlation_id": {"type": "string", "minLength": 1}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "lineage_id", "lot34_state_checksum", "lot34_audit_checksum",
        "quality_state_collection_checksum", "anomaly_collection_checksum", "quality_veto_checksum", "available_at"
      ],
      "properties": {
        "schema_version": {"const": "lot35-lineage-envelope-v1"},
        "lineage_id": {"type": "string", "minLength": 1},
        "lot34_state_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lot34_audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "quality_state_collection_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "anomaly_collection_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "quality_veto_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "available_at": {"type": "string", "pattern": "Z$"}
      }
    },
    "event_time": {"type": "string", "pattern": "Z$"},
    "available_at": {"type": "string", "pattern": "Z$"},
    "generated_at": {"type": "string", "pattern": "Z$"},
    "validation_state": {"enum": ["VALIDATED_RECONCILIATION_ONLY", "BLOCKED_RECONCILIATION"]},
    "reports": {"type": "array", "minItems": 1, "items": {"$ref": "reconciliation_report_v1.schema.json"}},
    "veto": {"$ref": "reconciliation_veto_v1.schema.json"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "lot_35_records_processed_total", "lot_35_validation_failures_total",
        "lot_35_match_total", "lot_35_tolerated_diff_total", "lot_35_minor_divergence_total",
        "lot_35_critical_divergence_total", "lot_35_processing_latency_us"
      ],
      "properties": {
        "schema_version": {"const": "lot35-metrics-v1"},
        "lot_35_records_processed_total": {"type": "integer", "minimum": 0},
        "lot_35_validation_failures_total": {"type": "integer", "minimum": 0},
        "lot_35_match_total": {"type": "integer", "minimum": 0},
        "lot_35_tolerated_diff_total": {"type": "integer", "minimum": 0},
        "lot_35_minor_divergence_total": {"type": "integer", "minimum": 0},
        "lot_35_critical_divergence_total": {"type": "integer", "minimum": 0},
        "lot_35_processing_latency_us": {"type": "integer", "minimum": 0}
      }
    },
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "analysis_only": {"const": true},
    "used_for_decision": {"const": false},
    "external_connectivity_allowed": {"const": false},
    "network_ingestion_allowed": {"const": false},
    "real_credentials_allowed": {"const": false},
    "market_event_publication_allowed": {"const": false},
    "raw_data_mutation_allowed": {"const": false},
    "signal_generation_allowed": {"const": false},
    "risk_approval_allowed": {"const": false},
    "order_routing_allowed": {"const": false},
    "trade_allowed": {"const": false},
    "execution_allowed": {"const": false},
    "approved_size": {"const": 0},
    "output_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
