{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market_data_quality_engine_state_v1.schema.json",
  "title": "MarketDataQualityEngineStateV1",
  "type": "object",
  "required": ["schema_version", "run_context", "lineage", "event_time", "available_at", "generated_at", "validation_state", "quality_states", "anomalies", "quarantine_record_ids", "veto", "metrics", "reason_codes", "analysis_only", "used_for_decision", "external_connectivity_allowed", "network_ingestion_allowed", "real_credentials_allowed", "market_event_publication_allowed", "raw_data_mutation_allowed", "signal_generation_allowed", "risk_approval_allowed", "order_routing_allowed", "trade_allowed", "execution_allowed", "approved_size", "output_checksum"],
  "properties": {
    "schema_version": {"const": "market-data-quality-engine-state-v1"},
    "run_context": {"type": "object"},
    "lineage": {"type": "object"},
    "event_time": {"type": "string", "format": "date-time"},
    "available_at": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "validation_state": {"enum": ["VALIDATED_DATA_QUALITY_ONLY", "BLOCKED_DATA_QUALITY"]},
    "quality_states": {"type": "array", "minItems": 1},
    "anomalies": {"type": "array"},
    "quarantine_record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "veto": {"type": "object"},
    "metrics": {"type": "object"},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "analysis_only": {"const": true},
    "used_for_decision": {"const": false},
    "external_connectivity_allowed": {"const": false},
    "network_ingestion_allowed": {"const": false},
    "real_credentials_allowed": {"const": false},
    "market_event_publication_allowed": {"const": false},
    "raw_data_mutation_allowed": {"const": false},
    "signal_generation_allowed": {"const": false},
    "risk_approval_allowed": {"const": false},
    "order_routing_allowed": {"const": false},
    "trade_allowed": {"const": false},
    "execution_allowed": {"const": false},
    "approved_size": {"const": 0},
    "output_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
