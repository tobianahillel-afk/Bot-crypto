{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book_health_veto_v1.schema.json",
  "title": "BookHealthVetoV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "consequence", "veto_active", "critical_veto_active",
    "trade_health_threshold", "system_health_threshold",
    "critical_failure_consequence", "system_threshold_consequence",
    "book_health_score", "reason_codes", "veto_checksum"
  ],
  "properties": {
    "schema_version": {"const": "book-health-veto-v1"},
    "consequence": {"enum": ["NONE", "WAIT", "PAUSE", "BLOCK"]},
    "veto_active": {"type": "boolean"},
    "critical_veto_active": {"type": "boolean"},
    "trade_health_threshold": {"$ref": "#/$defs/score"},
    "system_health_threshold": {"$ref": "#/$defs/score"},
    "critical_failure_consequence": {"const": "BLOCK"},
    "system_threshold_consequence": {"const": "PAUSE"},
    "book_health_score": {"$ref": "#/$defs/score"},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
    },
    "veto_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "score": {
      "type": "string",
      "pattern": "^(?:100(?:\\.0+)?|(?:0|[1-9][0-9]?)(?:\\.[0-9]+)?)$"
    }
  }
}
