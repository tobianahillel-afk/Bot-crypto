{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classified_trade_v1.schema.json",
  "title": "ClassifiedTradeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trade", "aggressor_classification", "classification_method", "confidence", "confidence_version", "quote_snapshot_checksum", "reason_codes"],
  "properties": {
    "schema_version": {"const": "classified-trade-v1"},
    "trade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_id", "venue", "instrument_id", "market_type", "trade_id", "event_time", "receive_time", "price", "quantity", "source_side"],
      "properties": {
        "schema_version": {"const": "timestamped-trade-v1"},
        "source_id": {"type": "string", "minLength": 1},
        "venue": {"type": "string", "minLength": 1},
        "instrument_id": {"type": "string", "minLength": 1},
        "market_type": {"const": "SPOT"},
        "trade_id": {"type": "string", "minLength": 1},
        "event_time": {"type": "string", "minLength": 1},
        "receive_time": {"type": "string", "minLength": 1},
        "price": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "quantity": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "source_side": {"const": "UNKNOWN"}
      }
    },
    "aggressor_classification": {"enum": ["BUY_AGGRESSOR", "SELL_AGGRESSOR", "UNKNOWN"]},
    "classification_method": {"enum": ["QUOTE_TEST", "TICK_RULE", "NONE"]},
    "confidence": {"enum": ["0", "0.5", "1"]},
    "confidence_version": {"const": "lot44-aggressor-confidence-v1"},
    "quote_snapshot_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
