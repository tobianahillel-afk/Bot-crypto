{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market_data_quality_engine_audit_v1.schema.json",
  "title": "MarketDataQualityEngineAuditV1",
  "type": "object",
  "required": ["schema_version", "code_commit", "state_output_checksum", "config_checksum", "lot33_state_checksum", "lot33_audit_checksum", "record_count", "anomaly_count", "quarantined_record_count", "veto_action", "validation_state", "analysis_only", "used_for_decision", "external_connectivity_allowed", "network_ingestion_allowed", "real_credentials_allowed", "market_event_publication_allowed", "raw_data_mutation_allowed", "signal_generation_allowed", "risk_approval_allowed", "order_routing_allowed", "trade_allowed", "execution_allowed", "approved_size", "audit_checksum"],
  "properties": {
    "schema_version": {"const": "market-data-quality-engine-audit-v1"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "state_output_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot33_state_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot33_audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 0},
    "anomaly_count": {"type": "integer", "minimum": 0},
    "quarantined_record_count": {"type": "integer", "minimum": 0},
    "veto_action": {"enum": ["ALLOW_ANALYSIS", "BLOCK_ANALYSIS_OR_TRADING"]},
    "validation_state": {"enum": ["VALIDATED_DATA_QUALITY_ONLY", "BLOCKED_DATA_QUALITY"]},
    "analysis_only": {"const": true},
    "used_for_decision": {"const": false},
    "external_connectivity_allowed": {"const": false},
    "network_ingestion_allowed": {"const": false},
    "real_credentials_allowed": {"const": false},
    "market_event_publication_allowed": {"const": false},
    "raw_data_mutation_allowed": {"const": false},
    "signal_generation_allowed": {"const": false},
    "risk_approval_allowed": {"const": false},
    "order_routing_allowed": {"const": false},
    "trade_allowed": {"const": false},
    "execution_allowed": {"const": false},
    "approved_size": {"const": 0},
    "audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
