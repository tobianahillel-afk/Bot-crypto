{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reconstructed_order_book_v1.schema.json",
  "title": "ReconstructedOrderBookV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "venue",
    "instrument_id",
    "market_type",
    "event_time",
    "receive_time",
    "base_snapshot_checksum",
    "base_sequence_id",
    "sequence_id",
    "sequence_anchor",
    "synchronization_state",
    "bids",
    "asks",
    "applied_delta_count",
    "book_checksum"
  ],
  "properties": {
    "schema_version": {"const": "reconstructed-order-book-v1"},
    "source_id": {"type": "string", "minLength": 1},
    "venue": {"type": "string", "minLength": 1},
    "instrument_id": {"type": "string", "minLength": 1},
    "market_type": {"const": "SPOT"},
    "event_time": {"type": "string", "minLength": 1},
    "receive_time": {"type": "string", "minLength": 1},
    "base_snapshot_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_sequence_id": {"type": "integer", "minimum": 0},
    "sequence_id": {"type": "integer", "minimum": 0},
    "sequence_anchor": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "synchronization_state": {"const": "SYNCED"},
    "bids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/level"}},
    "asks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/level"}},
    "applied_delta_count": {"type": "integer", "minimum": 1},
    "book_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "quantity"],
      "properties": {
        "price": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "quantity": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}
      }
    }
  }
}
