{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order_book_snapshot_raw_v1.schema.json",
  "title": "OrderBookSnapshotRawV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "venue", "instrument_id", "market_type", "event_time", "receive_time", "sequence_id", "venue_state", "bids", "asks", "used_for_decision"],
  "properties": {
    "schema_version": {"const": "order-book-snapshot-raw-v1"},
    "source_id": {"type": "string", "minLength": 1},
    "venue": {"type": "string", "minLength": 1},
    "instrument_id": {"type": "string", "minLength": 1},
    "market_type": {"const": "SPOT"},
    "event_time": {"type": "string", "minLength": 1},
    "receive_time": {"type": "string", "minLength": 1},
    "sequence_id": {"type": "integer", "minimum": 0},
    "venue_state": {"enum": ["OPEN", "LOCKED"]},
    "bids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/level"}},
    "asks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/level"}},
    "used_for_decision": {"const": false}
  },
  "$defs": {
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "quantity"],
      "properties": {
        "price": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "quantity": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}
      }
    }
  }
}
