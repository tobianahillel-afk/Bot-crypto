{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lot_validation_report_v1.schema.json",
  "title": "LotValidationReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "validated_lots", "required_validator_count", "closure_candidate_ready", "reason_codes"],
  "properties": {
    "schema_version": {"const": "lot-validation-report-v1"},
    "validated_lots": {"const": [31, 32, 33, 34, 35, 36]},
    "required_validator_count": {"type": "integer", "minimum": 1},
    "closure_candidate_ready": {"type": "boolean"},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
