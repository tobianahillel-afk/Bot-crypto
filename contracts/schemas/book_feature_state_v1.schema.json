{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant-bot.local/contracts/book_feature_state_v1.schema.json",
  "title": "BookFeatureStateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "venue", "instrument_id", "market_type", "event_time", "receive_time", "decision_time", "sequence_id", "horizon", "spread_absolute", "spread_bps", "mid_price", "microprice", "top_of_book", "depth_bands", "cumulative_depth", "book_quality", "observed_depth_only", "extrapolated", "reason_codes", "feature_checksum"],
  "properties": {
    "schema_version": {"const": "book-feature-state-v1"},
    "source_id": {"type": "string", "minLength": 1},
    "venue": {"type": "string", "minLength": 1},
    "instrument_id": {"type": "string", "minLength": 1},
    "market_type": {"const": "SPOT"},
    "event_time": {"type": "string", "pattern": "Z$"},
    "receive_time": {"type": "string", "pattern": "Z$"},
    "decision_time": {"type": "string", "pattern": "Z$"},
    "sequence_id": {"type": "integer", "minimum": 1},
    "horizon": {"const": "BOOK_SNAPSHOT"},
    "spread_absolute": {"$ref": "#/$defs/positiveDecimal"},
    "spread_bps": {"$ref": "#/$defs/positiveDecimal"},
    "mid_price": {"$ref": "#/$defs/positiveDecimal"},
    "microprice": {"$ref": "#/$defs/positiveDecimal"},
    "top_of_book": {"$ref": "#/$defs/topOfBook"},
    "depth_bands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/depthBand"}},
    "cumulative_depth": {"$ref": "#/$defs/cumulativeDepth"},
    "book_quality": {"$ref": "#/$defs/bookQuality"},
    "observed_depth_only": {"const": true},
    "extrapolated": {"const": false},
    "reason_codes": {"$ref": "#/$defs/reasonCodes"},
    "feature_checksum": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "positiveDecimal": {"type": "string", "pattern": "^(?:0*[1-9][0-9]*(?:\\.[0-9]+)?|0+\\.[0-9]*[1-9][0-9]*)$"},
    "nonNegativeDecimal": {"type": "string", "pattern": "^(?:0|0*[0-9]+(?:\\.[0-9]+)?)$"},
    "signedDecimal": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reasonCodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}},
    "topOfBook": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "best_bid_price", "best_bid_quantity", "best_ask_price", "best_ask_quantity"],
      "properties": {
        "schema_version": {"const": "lot41-top-of-book-v1"},
        "best_bid_price": {"$ref": "#/$defs/positiveDecimal"},
        "best_bid_quantity": {"$ref": "#/$defs/positiveDecimal"},
        "best_ask_price": {"$ref": "#/$defs/positiveDecimal"},
        "best_ask_quantity": {"$ref": "#/$defs/positiveDecimal"}
      }
    },
    "depthBand": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "band_bps", "bid_quantity", "ask_quantity", "bid_levels_observed", "ask_levels_observed", "imbalance", "imbalance_status", "coverage_status"],
      "properties": {
        "schema_version": {"const": "lot41-depth-band-v1"},
        "band_bps": {"$ref": "#/$defs/positiveDecimal"},
        "bid_quantity": {"$ref": "#/$defs/nonNegativeDecimal"},
        "ask_quantity": {"$ref": "#/$defs/nonNegativeDecimal"},
        "bid_levels_observed": {"type": "integer", "minimum": 0},
        "ask_levels_observed": {"type": "integer", "minimum": 0},
        "imbalance": {"oneOf": [{"$ref": "#/$defs/signedDecimal"}, {"type": "null"}]},
        "imbalance_status": {"enum": ["DEFINED", "UNDEFINED_ZERO_DENOMINATOR"]},
        "coverage_status": {"const": "OBSERVED_LEVELS_ONLY"}
      }
    },
    "cumulativeLevel": {
      "type": "object", "additionalProperties": false,
      "required": ["price", "quantity", "cumulative_quantity", "distance_bps"],
      "properties": {
        "price": {"$ref": "#/$defs/positiveDecimal"},
        "quantity": {"$ref": "#/$defs/positiveDecimal"},
        "cumulative_quantity": {"$ref": "#/$defs/positiveDecimal"},
        "distance_bps": {"$ref": "#/$defs/nonNegativeDecimal"}
      }
    },
    "cumulativeDepth": {
      "type": "object", "additionalProperties": false,
      "required": ["bids", "asks"],
      "properties": {
        "bids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cumulativeLevel"}},
        "asks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cumulativeLevel"}}
      }
    },
    "bookQuality": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "health_status", "book_health_score", "consequence", "sequence_id", "integrity_checksum", "veto_checksum"],
      "properties": {
        "schema_version": {"const": "lot41-book-quality-binding-v1"},
        "health_status": {"const": "HEALTHY"},
        "book_health_score": {"const": "100"},
        "consequence": {"const": "NONE"},
        "sequence_id": {"type": "integer", "minimum": 1},
        "integrity_checksum": {"$ref": "#/$defs/sha256"},
        "veto_checksum": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
