    "lot34_state_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot34_audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot35_state_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot35_audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "freshness_audit_count": {"type": "integer", "minimum": 1},
