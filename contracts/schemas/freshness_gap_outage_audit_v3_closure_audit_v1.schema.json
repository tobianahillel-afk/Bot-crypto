    "reconciliation_veto_action": {"enum": ["ALLOW_ANALYSIS", "PAUSE", "KILL_SWITCH"]},
    "validation_state": {"enum": ["VALIDATED_V3_CLOSURE_CANDIDATE", "BLOCKED_V3_CLOSURE"]},
