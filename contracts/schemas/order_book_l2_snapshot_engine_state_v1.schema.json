{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order_book_l2_snapshot_engine_state_v1.schema.json",
  "title": "OrderBookL2SnapshotEngineStateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_context", "lineage", "event_time", "receive_time", "generated_at", "validation_state", "input_fixture_checksum", "snapshot", "book_health", "metrics", "reason_codes", "safety", "output_checksum"],
  "properties": {
    "schema_version": {"const": "order-book-l2-snapshot-engine-state-v1"},
    "run_context": {"$ref": "#/$defs/run_context"},
    "lineage": {"$ref": "#/$defs/lineage"},
    "event_time": {"type": "string", "minLength": 1},
    "receive_time": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "validation_state": {"const": "VALIDATED_OFFLINE_L2_SNAPSHOT_ONLY"},
    "input_fixture_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot": {"$ref": "order_book_snapshot_v1.schema.json"},
    "book_health": {"$ref": "book_health_state_v1.schema.json"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}},
    "safety": {"$ref": "#/$defs/safety"},
    "output_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "run_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "runtime_mode", "config_version", "code_commit", "correlation_id"],
      "properties": {
        "schema_version": {"const": "lot38-run-context-v1"},
        "run_id": {"type": "string", "minLength": 1},
        "runtime_mode": {"const": "OFFLINE_MICROSTRUCTURE_RESEARCH_ONLY"},
        "config_version": {"type": "string", "minLength": 1},
        "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "correlation_id": {"type": "string", "minLength": 1}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "lineage_id", "entry_gate_checksum", "lot37_state_checksum", "lot37_audit_checksum", "lot37_contract_registry_checksum", "lot37_capability_matrix_checksum", "input_fixture_checksum", "available_at"],
      "properties": {
        "schema_version": {"const": "lot38-lineage-envelope-v1"},
        "lineage_id": {"type": "string", "minLength": 1},
        "entry_gate_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lot37_state_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lot37_audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lot37_contract_registry_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lot37_capability_matrix_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_fixture_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "available_at": {"type": "string", "minLength": 1}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "lot_38_records_processed_total", "lot_38_source_levels_total", "lot_38_normalized_levels_total", "lot_38_duplicate_levels_aggregated_total", "lot_38_published_levels_total", "lot_38_validation_failures_total", "lot_38_processing_latency_us", "latency_measurement_status"],
      "properties": {
        "schema_version": {"const": "lot38-metrics-v1"},
        "lot_38_records_processed_total": {"const": 1},
        "lot_38_source_levels_total": {"type": "integer", "minimum": 2},
        "lot_38_normalized_levels_total": {"type": "integer", "minimum": 2},
        "lot_38_duplicate_levels_aggregated_total": {"type": "integer", "minimum": 0},
        "lot_38_published_levels_total": {"type": "integer", "minimum": 2},
        "lot_38_validation_failures_total": {"const": 0},
        "lot_38_processing_latency_us": {"type": "null"},
        "latency_measurement_status": {"const": "NOT_MEASURED_OFFLINE_DETERMINISTIC_REPLAY"}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_only", "used_for_decision", "external_connectivity_allowed", "network_ingestion_allowed", "real_credentials_allowed", "market_event_publication_allowed", "raw_data_mutation_allowed", "participant_behavior_inference_explicitly_labeled", "scenario_score_is_signal", "signal_generation_allowed", "risk_approval_allowed", "order_routing_allowed", "trade_allowed", "execution_allowed", "approved_size"],
      "properties": {
        "analysis_only": {"const": true},
        "used_for_decision": {"const": false},
        "external_connectivity_allowed": {"const": false},
        "network_ingestion_allowed": {"const": false},
        "real_credentials_allowed": {"const": false},
        "market_event_publication_allowed": {"const": false},
        "raw_data_mutation_allowed": {"const": false},
        "participant_behavior_inference_explicitly_labeled": {"const": true},
        "scenario_score_is_signal": {"const": false},
        "signal_generation_allowed": {"const": false},
        "risk_approval_allowed": {"const": false},
        "order_routing_allowed": {"const": false},
        "trade_allowed": {"const": false},
        "execution_allowed": {"const": false},
        "approved_size": {"const": 0}
      }
    }
  }
}
