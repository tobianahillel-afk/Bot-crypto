{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant-bot.local/contracts/lot38_v4_entry_gate_v1.schema.json",
  "title": "Lot38V4EntryGateV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_lot",
    "base_commit",
    "current_version",
    "gate_status",
    "human_decision",
    "implementation_started",
    "owner",
    "runtime_mode",
    "canonical_roadmap",
    "prerequisites",
    "required_inputs",
    "required_outputs",
    "allowed_scope",
    "forbidden_scope",
    "quality_gates",
    "safety",
    "next_lot",
    "next_lot_status",
    "output_checksum"
  ],
  "properties": {
    "schema_version": {"const": "lot38-v4-entry-gate-v1"},
    "target_lot": {"const": 38},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "current_version": {"const": "0.37.0"},
    "gate_status": {"const": "GO_LOT38_IMPLEMENTATION_ENTRY"},
    "human_decision": {"const": "APPROVED_START_LOT38"},
    "implementation_started": {"const": false},
    "owner": {"const": "MicrostructureDomain"},
    "runtime_mode": {"const": "OFFLINE_MICROSTRUCTURE_RESEARCH_ONLY"},
    "canonical_roadmap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "source_line", "source_blob_sha", "lot_id", "title", "version_id"],
      "properties": {
        "source_path": {"const": "data/audit/product_scope_roadmap_lot21.jsonl"},
        "source_line": {"const": 39},
        "source_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "lot_id": {"const": "Lot 38"},
        "title": {"const": "Order Book L2 Snapshot Engine"},
        "version_id": {"const": "V4_MICROSTRUCTURE_LIQUIDITY"}
      }
    },
    "prerequisites": {"type": "object", "additionalProperties": true},
    "required_inputs": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_outputs": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_scope": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_scope": {
      "type": "array",
      "minItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_coverage_min_percent", "branch_coverage_min_percent", "mutation_score_min_percent", "anti_flake_repetitions"],
      "properties": {
        "line_coverage_min_percent": {"const": 95},
        "branch_coverage_min_percent": {"const": 90},
        "mutation_score_min_percent": {"const": 80},
        "anti_flake_repetitions": {"const": 3}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_only",
        "used_for_decision",
        "external_connectivity_allowed",
        "network_ingestion_allowed",
        "real_credentials_allowed",
        "market_event_publication_allowed",
        "raw_data_mutation_allowed",
        "participant_behavior_inference_explicitly_labeled",
        "scenario_score_is_signal",
        "signal_generation_allowed",
        "risk_approval_allowed",
        "order_routing_allowed",
        "trade_allowed",
        "execution_allowed",
        "approved_size"
      ],
      "properties": {
        "analysis_only": {"const": true},
        "used_for_decision": {"const": false},
        "external_connectivity_allowed": {"const": false},
        "network_ingestion_allowed": {"const": false},
        "real_credentials_allowed": {"const": false},
        "market_event_publication_allowed": {"const": false},
        "raw_data_mutation_allowed": {"const": false},
        "participant_behavior_inference_explicitly_labeled": {"const": true},
        "scenario_score_is_signal": {"const": false},
        "signal_generation_allowed": {"const": false},
        "risk_approval_allowed": {"const": false},
        "order_routing_allowed": {"const": false},
        "trade_allowed": {"const": false},
        "execution_allowed": {"const": false},
        "approved_size": {"const": 0}
      }
    },
    "next_lot": {"const": 39},
    "next_lot_status": {"const": "PLANNED_LOCKED"},
    "output_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
