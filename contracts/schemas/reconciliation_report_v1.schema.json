{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reconciliation_report_v1.schema.json",
  "title": "ReconciliationReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "reconciliation_id", "entity_type", "source_of_truth",
    "primary_record_id", "secondary_record_id", "classification", "delta",
    "tolerance_version", "duplicate", "orphan", "corrective_action", "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "reconciliation-report-v1"},
    "reconciliation_id": {"type": "string", "minLength": 1},
    "entity_type": {"enum": ["CANDLE", "TRADE", "BOOK"]},
    "source_of_truth": {"enum": ["PRIMARY", "SECONDARY", "UNKNOWN"]},
    "primary_record_id": {"type": ["string", "null"]},
    "secondary_record_id": {"type": ["string", "null"]},
    "classification": {"enum": ["MATCH", "TOLERATED_DIFF", "MINOR_DIVERGENCE", "CRITICAL_DIVERGENCE"]},
    "delta": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "quantity_abs", "price_abs", "fee_abs", "balance_abs", "position_abs", "timestamp_us"],
          "properties": {
            "schema_version": {"const": "reconciliation-delta-v1"},
            "quantity_abs": {"type": "string"},
            "price_abs": {"type": "string"},
            "fee_abs": {"type": "string"},
            "balance_abs": {"type": "string"},
            "position_abs": {"type": "string"},
            "timestamp_us": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "tolerance_version": {"type": "string", "minLength": 1},
    "duplicate": {"type": "boolean"},
    "orphan": {"type": "boolean"},
    "corrective_action": {"enum": ["NONE", "REVIEW_AND_PAUSE", "MANUAL_RECONCILIATION_REQUIRED"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
