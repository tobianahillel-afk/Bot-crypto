{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order_flow_delta_cvd_engine_state_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "order-flow-delta-cvd-engine-state-v1"},
    "run_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "lot45-run-context-v1"},
        "run_id": {"type": "string", "minLength": 1},
        "runtime_mode": {"const": "OFFLINE_MICROSTRUCTURE_RESEARCH_ONLY"},
        "config_version": {"const": "lot45-order-flow-delta-cvd-config-v1"},
        "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "correlation_id": {"type": "string", "minLength": 1}
      },
      "required": ["schema_version", "run_id", "runtime_mode", "config_version", "code_commit", "correlation_id"]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "lot45-lineage-envelope-v1"},
        "lot44_state_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lot44_audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lot44_confidence_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lot44_code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "available_at": {"type": "string", "format": "date-time"}
      },
      "required": ["schema_version", "lot44_state_checksum", "lot44_audit_checksum", "lot44_confidence_checksum", "lot44_code_commit", "available_at"]
    },
    "event_time": {"type": "string", "format": "date-time"},
    "receive_time": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "validation_state": {"const": "VALIDATED_OFFLINE_ORDER_FLOW_DELTA_CVD_ONLY"},
    "order_flow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "order-flow-state-v1"},
        "trades_total": {"type": "integer", "minimum": 0},
        "buy_trades_total": {"type": "integer", "minimum": 0},
        "sell_trades_total": {"type": "integer", "minimum": 0},
        "unknown_trades_total": {"type": "integer", "minimum": 0},
        "total_volume": {"type": "string"},
        "buy_volume": {"type": "string"},
        "sell_volume": {"type": "string"},
        "unknown_volume": {"type": "string"},
        "signed_delta": {"type": "string"},
        "unknown_volume_ratio": {"type": "string"},
        "order_flow_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["schema_version", "trades_total", "buy_trades_total", "sell_trades_total", "unknown_trades_total", "total_volume", "buy_volume", "sell_volume", "unknown_volume", "signed_delta", "unknown_volume_ratio", "order_flow_checksum"]
    },
    "cvd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "cvd-series-v1"},
        "policy_version": {"const": "lot45-order-flow-delta-cvd-policy-v1"},
        "starting_cvd": {"const": "0"},
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_version": {"const": "cvd-point-v1"},
              "sequence": {"type": "integer", "minimum": 0},
              "trade_id": {"type": "string", "minLength": 1},
              "event_time": {"type": "string", "format": "date-time"},
              "receive_time": {"type": "string", "format": "date-time"},
              "aggressor_classification": {"enum": ["BUY_AGGRESSOR", "SELL_AGGRESSOR", "UNKNOWN"]},
              "quantity": {"type": "string"},
              "signed_trade_delta": {"type": "string"},
              "cumulative_delta": {"type": "string"}
            },
            "required": ["schema_version", "sequence", "trade_id", "event_time", "receive_time", "aggressor_classification", "quantity", "signed_trade_delta", "cumulative_delta"]
          }
        },
        "final_cvd": {"type": "string"},
        "cvd_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["schema_version", "policy_version", "starting_cvd", "points", "final_cvd", "cvd_checksum"]
    },
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analysis_only": {"const": true},
        "approved_size": {"const": 0},
        "execution_allowed": {"const": false},
        "external_connectivity_allowed": {"const": false},
        "market_event_publication_allowed": {"const": false},
        "network_ingestion_allowed": {"const": false},
        "order_routing_allowed": {"const": false},
        "participant_behavior_inference_explicitly_labeled": {"const": true},
        "raw_data_mutation_allowed": {"const": false},
        "real_credentials_allowed": {"const": false},
        "risk_approval_allowed": {"const": false},
        "scenario_score_is_signal": {"const": false},
        "signal_generation_allowed": {"const": false},
        "trade_allowed": {"const": false},
        "used_for_decision": {"const": false}
      },
      "required": ["analysis_only", "approved_size", "execution_allowed", "external_connectivity_allowed", "market_event_publication_allowed", "network_ingestion_allowed", "order_routing_allowed", "participant_behavior_inference_explicitly_labeled", "raw_data_mutation_allowed", "real_credentials_allowed", "risk_approval_allowed", "scenario_score_is_signal", "signal_generation_allowed", "trade_allowed", "used_for_decision"]
    },
    "output_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["schema_version", "run_context", "lineage", "event_time", "receive_time", "generated_at", "validation_state", "order_flow", "cvd", "reason_codes", "safety", "output_checksum"]
}
