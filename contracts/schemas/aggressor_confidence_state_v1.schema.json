{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aggressor_confidence_state_v1.schema.json",
  "title": "AggressorConfidenceStateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "semantics", "quote_test_confidence", "tick_rule_confidence", "unknown_confidence", "confidence_checksum"],
  "properties": {
    "schema_version": {"const": "aggressor-confidence-state-v1"},
    "policy_version": {"const": "lot44-aggressor-confidence-v1"},
    "semantics": {"const": "DESCRIPTIVE_METHOD_CONFIDENCE_NOT_PROBABILITY"},
    "quote_test_confidence": {"const": "1"},
    "tick_rule_confidence": {"const": "0.5"},
    "unknown_confidence": {"const": "0"},
    "confidence_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
