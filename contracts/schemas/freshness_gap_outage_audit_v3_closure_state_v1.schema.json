    "validation_state": {"enum": ["VALIDATED_V3_CLOSURE_CANDIDATE", "BLOCKED_V3_CLOSURE"]},
    "freshness_audits": {"type": "array", "minItems": 1, "items": {"$ref": "freshness_gap_outage_evidence_v1.schema.json"}},
    "quality_states": {"type": "array", "minItems": 1, "items": {"$ref": "data_quality_state_v1.schema.json"}},
    "anomalies": {"type": "array", "items": {"$ref": "data_anomaly_v1.schema.json"}},
    "data_quality_veto": {"$ref": "data_quality_veto_v1.schema.json"},
    "reconciliation_veto": {"$ref": "reconciliation_veto_v1.schema.json"},
    "validation_report": {"$ref": "lot_validation_report_v1.schema.json"},
    "closure_manifest": {"$ref": "closure_manifest_v1.schema.json"},
    "metrics": {"type": "object"},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "analysis_only": {"const": true},
    "used_for_decision": {"const": false},
    "external_connectivity_allowed": {"const": false},
    "network_ingestion_allowed": {"const": false},
    "real_credentials_allowed": {"const": false},
    "market_event_publication_allowed": {"const": false},
    "raw_data_mutation_allowed": {"const": false},
    "signal_generation_allowed": {"const": false},
    "risk_approval_allowed": {"const": false},
    "order_routing_allowed": {"const": false},
    "trade_allowed": {"const": false},
    "execution_allowed": {"const": false},
    "approved_size": {"const": 0},
    "output_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
