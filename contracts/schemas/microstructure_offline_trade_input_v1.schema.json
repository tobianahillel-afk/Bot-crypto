{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "microstructure_offline_trade_input_v1.schema.json",
  "title": "MicrostructureOfflineTradeInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_only", "canonical_contract", "used_for_decision", "venue", "instrument_id", "event_time", "available_at", "trades"],
  "properties": {
    "schema_version": {"const": "microstructure-offline-trade-availability-fixture-v1"},
    "fixture_only": {"const": true},
    "canonical_contract": {"const": false},
    "used_for_decision": {"const": false},
    "venue": {"type": "string", "minLength": 1},
    "instrument_id": {"type": "string", "minLength": 1},
    "event_time": {"type": "string", "format": "date-time"},
    "available_at": {"type": "string", "format": "date-time"},
    "trades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trade_id", "price", "quantity", "side"],
        "properties": {
          "trade_id": {"type": "string", "minLength": 1},
          "price": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
          "quantity": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
          "side": {"const": "UNKNOWN"}
        }
      }
    }
  }
}
