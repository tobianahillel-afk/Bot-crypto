{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "microstructure_offline_trade_input_v1.schema.json",
  "title": "MicrostructureOfflineTradeInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "fixture_only", "canonical_contract", "source_id", "venue", "instrument_id", "market_type", "event_time", "available_at", "trades", "reason_codes", "used_for_decision"],
  "properties": {
    "schema_version": {"const": "lot37-offline-trade-availability-fixture-v1"},
    "fixture_id": {"type": "string", "minLength": 1},
    "fixture_only": {"const": true},
    "canonical_contract": {"const": false},
    "source_id": {"type": "string", "minLength": 1},
    "venue": {"type": "string", "minLength": 1},
    "instrument_id": {"type": "string", "minLength": 1},
    "market_type": {"const": "SPOT"},
    "event_time": {"type": "string", "minLength": 1},
    "available_at": {"type": "string", "minLength": 1},
    "trades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trade_id", "price", "quantity", "side"],
        "properties": {
          "trade_id": {"type": "string", "minLength": 1},
          "price": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
          "quantity": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
          "side": {"const": "UNKNOWN"}
        }
      }
    },
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "used_for_decision": {"const": false}
  }
}
