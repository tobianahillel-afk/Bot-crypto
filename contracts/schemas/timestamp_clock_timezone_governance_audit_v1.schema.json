{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant-bot.local/schemas/timestamp_clock_timezone_governance_audit_v1.schema.json",
  "title": "TimestampClockTimezoneGovernanceAuditV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "code_commit", "state_output_checksum", "config_checksum",
    "instrument_registry_checksum", "record_count", "out_of_order_record_count",
    "clock_health_status", "max_observed_clock_drift_us", "max_observed_total_latency_us",
    "validation_state", "analysis_only", "used_for_decision",
    "external_connectivity_allowed", "network_ingestion_allowed", "real_credentials_allowed",
    "signal_generation_allowed", "risk_approval_allowed", "order_routing_allowed",
    "trade_allowed", "execution_allowed", "approved_size", "audit_checksum"
  ],
  "properties": {
    "schema_version": {"const": "timestamp-clock-timezone-governance-audit-v1"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "state_output_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instrument_registry_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 1},
    "out_of_order_record_count": {"type": "integer", "minimum": 0},
    "clock_health_status": {"enum": ["HEALTHY", "DEGRADED", "BLOCKED"]},
    "max_observed_clock_drift_us": {"type": "integer", "minimum": 0},
    "max_observed_total_latency_us": {"type": "integer", "minimum": 0},
    "validation_state": {"const": "VALIDATED_TEMPORAL_ONLY"},
    "analysis_only": {"const": true},
    "used_for_decision": {"const": false},
    "external_connectivity_allowed": {"const": false},
    "network_ingestion_allowed": {"const": false},
    "real_credentials_allowed": {"const": false},
    "signal_generation_allowed": {"const": false},
    "risk_approval_allowed": {"const": false},
    "order_routing_allowed": {"const": false},
    "trade_allowed": {"const": false},
    "execution_allowed": {"const": false},
    "approved_size": {"const": 0},
    "audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
