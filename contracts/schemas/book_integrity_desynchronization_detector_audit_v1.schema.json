{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book_integrity_desynchronization_detector_audit_v1.schema.json",
  "title": "BookIntegrityDesynchronizationDetectorAuditV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "code_commit", "config_checksum", "entry_gate_checksum",
    "lot39_state_checksum", "lot39_audit_checksum",
    "lot39_reconstructed_book_checksum", "lot39_delta_fixture_checksum",
    "state_output_checksum", "integrity_checksum", "veto_checksum",
    "health_status", "consequence", "safety", "audit_checksum"
  ],
  "properties": {
    "schema_version": {"const": "book-integrity-desynchronization-detector-audit-v1"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "config_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry_gate_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot39_state_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot39_audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot39_reconstructed_book_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot39_delta_fixture_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_output_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "integrity_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "veto_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "health_status": {"enum": ["HEALTHY", "DEGRADED", "CRITICAL"]},
    "consequence": {"enum": ["NONE", "WAIT", "PAUSE", "BLOCK"]},
    "safety": {"$ref": "#/$defs/safety"},
    "audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_only", "approved_size", "execution_allowed",
        "external_connectivity_allowed", "market_event_publication_allowed",
        "network_ingestion_allowed", "order_routing_allowed",
        "participant_behavior_inference_explicitly_labeled", "raw_data_mutation_allowed",
        "real_credentials_allowed", "risk_approval_allowed", "scenario_score_is_signal",
        "signal_generation_allowed", "trade_allowed", "used_for_decision"
      ],
      "properties": {
        "analysis_only": {"const": true},
        "approved_size": {"const": 0},
        "execution_allowed": {"const": false},
        "external_connectivity_allowed": {"const": false},
        "market_event_publication_allowed": {"const": false},
        "network_ingestion_allowed": {"const": false},
        "order_routing_allowed": {"const": false},
        "participant_behavior_inference_explicitly_labeled": {"const": true},
        "raw_data_mutation_allowed": {"const": false},
        "real_credentials_allowed": {"const": false},
        "risk_approval_allowed": {"const": false},
        "scenario_score_is_signal": {"const": false},
        "signal_generation_allowed": {"const": false},
        "trade_allowed": {"const": false},
        "used_for_decision": {"const": false}
      }
    }
  }
}
