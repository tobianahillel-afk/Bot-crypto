{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant-bot.local/schemas/multi_horizon_forecast_v1.schema.json",
  "title": "MultiHorizonForecastV1",
  "description": "Planned locked calibrated forecast contract. Forbidden in Lot 26.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "forecast_id",
    "instrument_id",
    "decision_time",
    "available_at",
    "horizon_registry_version",
    "state_ids",
    "forecasts",
    "cross_horizon_dependence",
    "model_ids",
    "dataset_id",
    "feature_set_id",
    "code_commit",
    "lineage_id",
    "validation_state"
  ],
  "properties": {
    "schema_version": {"const": "multi-horizon-forecast-v1"},
    "forecast_id": {"type": "string", "minLength": 1},
    "instrument_id": {"type": "string", "minLength": 1},
    "decision_time": {"type": "string", "format": "date-time"},
    "available_at": {"type": "string", "format": "date-time"},
    "horizon_registry_version": {"type": "string", "minLength": 1},
    "state_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "forecasts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "forecast_horizon",
          "expected_return",
          "median_return",
          "return_quantiles",
          "volatility_forecast",
          "direction_probability",
          "target_hit_probability",
          "stop_hit_probability",
          "time_to_target_distribution",
          "maximum_adverse_excursion_distribution",
          "maximum_favorable_excursion_distribution",
          "regime_transition_probability",
          "liquidity_risk",
          "model_uncertainty",
          "data_uncertainty",
          "calibration_id"
        ],
        "properties": {
          "forecast_horizon": {"type": "string", "minLength": 1},
          "expected_return": {"type": ["number", "null"]},
          "median_return": {"type": ["number", "null"]},
          "return_quantiles": {"type": ["object", "null"]},
          "volatility_forecast": {"type": ["number", "null"], "minimum": 0},
          "direction_probability": {"type": ["object", "null"]},
          "target_hit_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "stop_hit_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "time_to_target_distribution": {"type": ["object", "null"]},
          "maximum_adverse_excursion_distribution": {"type": ["object", "null"]},
          "maximum_favorable_excursion_distribution": {"type": ["object", "null"]},
          "regime_transition_probability": {"type": ["object", "null"]},
          "liquidity_risk": {"type": ["object", "null"]},
          "model_uncertainty": {"type": ["object", "null"]},
          "data_uncertainty": {"type": ["object", "null"]},
          "calibration_id": {"type": ["string", "null"]}
        }
      }
    },
    "cross_horizon_dependence": {"type": "object"},
    "model_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "dataset_id": {"type": "string"},
    "feature_set_id": {"type": "string"},
    "code_commit": {"type": "string"},
    "lineage_id": {"type": "string"},
    "validation_state": {"enum": ["VALID", "DEGRADED", "UNKNOWN", "BLOCKED"]},
    "trade_allowed": {"const": false},
    "execution_allowed": {"const": false}
  }
}
