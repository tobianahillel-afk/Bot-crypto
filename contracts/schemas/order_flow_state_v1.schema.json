{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order_flow_state_v1.schema.json",
  "title": "OrderFlowStateV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "windows",
    "trades_total",
    "buy_trades_total",
    "sell_trades_total",
    "unknown_trades_total",
    "total_volume",
    "buy_volume",
    "sell_volume",
    "unknown_volume",
    "signed_delta",
    "unknown_volume_ratio",
    "classification_coverage",
    "confidence_weighted_volume",
    "confidence_weighted_coverage",
    "order_flow_checksum"
  ],
  "properties": {
    "schema_version": {"const": "order-flow-state-v1"},
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version", "window_start", "window_end", "event_time", "receive_time",
          "session_id", "trades_total", "buy_trades_total", "sell_trades_total",
          "unknown_trades_total", "total_volume", "buy_volume", "sell_volume",
          "unknown_volume", "signed_delta", "signed_imbalance", "classification_coverage",
          "confidence_weighted_volume", "confidence_weighted_coverage", "delta_impulse",
          "window_checksum"
        ],
        "properties": {
          "schema_version": {"const": "order-flow-window-v1"},
          "window_start": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)(?!9999-12-31T23:59:59\\.)(?:(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"},
          "window_end": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)(?!9999-12-31T23:59:59\\.)(?:(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"},
          "event_time": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)(?!9999-12-31T23:59:59\\.)(?:(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"},
          "receive_time": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)(?!9999-12-31T23:59:59\\.)(?:(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"},
          "session_id": {"type": "string", "minLength": 1},
          "trades_total": {"type": "integer", "minimum": 1},
          "buy_trades_total": {"type": "integer", "minimum": 0},
          "sell_trades_total": {"type": "integer", "minimum": 0},
          "unknown_trades_total": {"type": "integer", "minimum": 0},
          "total_volume": {"type": "string", "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
          "buy_volume": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
          "sell_volume": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
          "unknown_volume": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
          "signed_delta": {"type": "string", "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$"},
          "signed_imbalance": {"type": "string", "pattern": "^(?:0|1|-1|0\\.[0-9]*[1-9]|-0\\.[0-9]*[1-9])$"},
          "classification_coverage": {"type": "string", "pattern": "^(?:0|1|0\\.[0-9]*[1-9])$"},
          "confidence_weighted_volume": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
          "confidence_weighted_coverage": {"type": "string", "pattern": "^(?:0|1|0\\.[0-9]*[1-9])$"},
          "delta_impulse": {"type": "string", "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$"},
          "window_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "trades_total": {"type": "integer", "minimum": 1},
    "buy_trades_total": {"type": "integer", "minimum": 0},
    "sell_trades_total": {"type": "integer", "minimum": 0},
    "unknown_trades_total": {"type": "integer", "minimum": 0},
    "total_volume": {"type": "string", "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
    "buy_volume": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
    "sell_volume": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
    "unknown_volume": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
    "signed_delta": {"type": "string", "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$"},
    "unknown_volume_ratio": {"type": "string", "pattern": "^(?:0|1|0\\.[0-9]*[1-9])$"},
    "classification_coverage": {"type": "string", "pattern": "^(?:0|1|0\\.[0-9]*[1-9])$"},
    "confidence_weighted_volume": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
    "confidence_weighted_coverage": {"type": "string", "pattern": "^(?:0|1|0\\.[0-9]*[1-9])$"},
    "order_flow_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
