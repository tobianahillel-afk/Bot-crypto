{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order_flow_state_v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "order-flow-state-v1"},
    "trades_total": {"type": "integer", "minimum": 0},
    "buy_trades_total": {"type": "integer", "minimum": 0},
    "sell_trades_total": {"type": "integer", "minimum": 0},
    "unknown_trades_total": {"type": "integer", "minimum": 0},
    "total_volume": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "buy_volume": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "sell_volume": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "unknown_volume": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "signed_delta": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "unknown_volume_ratio": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "order_flow_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": [
    "schema_version",
    "trades_total",
    "buy_trades_total",
    "sell_trades_total",
    "unknown_trades_total",
    "total_volume",
    "buy_volume",
    "sell_volume",
    "unknown_volume",
    "signed_delta",
    "unknown_volume_ratio",
    "order_flow_checksum"
  ],
  "type": "object"
}
