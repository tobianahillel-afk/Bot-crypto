{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant-bot.local/contracts/portfolio_decision_snapshot_v1.schema.json",
  "title": "PortfolioDecisionSnapshotV1",
  "description": "Immutable, point-in-time-consistent portfolio snapshot consumed by every risk-increasing or risk-reducing decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "snapshot_sequence",
    "ledger_watermark",
    "portfolio_state_id",
    "portfolio_state_hash",
    "position_state_ids",
    "open_order_state_ids",
    "pending_intent_state_ids",
    "reservation_ids",
    "account_state_id",
    "risk_limit_set_id",
    "market_state_ids",
    "model_state_ids",
    "strategy_state_id",
    "valuation_time",
    "decision_time",
    "available_at",
    "generated_at",
    "base_currency",
    "nav",
    "cash_total",
    "cash_reserved",
    "cash_available",
    "gross_exposure",
    "net_exposure",
    "portfolio_risk",
    "reserved_risk",
    "portfolio_heat",
    "drawdown",
    "reconciliation_state",
    "data_quality_state",
    "runtime_mode",
    "validation_state",
    "lineage_id",
    "state_hash"
  ],
  "properties": {
    "schema_version": {"const": "PortfolioDecisionSnapshotV1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "snapshot_sequence": {"type": "integer", "minimum": 0},
    "ledger_watermark": {"type": "string", "minLength": 1},
    "portfolio_state_id": {"type": "string", "minLength": 1},
    "portfolio_state_hash": {"$ref": "#/$defs/sha256"},
    "position_state_ids": {"$ref": "#/$defs/unique_ids"},
    "open_order_state_ids": {"$ref": "#/$defs/unique_ids"},
    "pending_intent_state_ids": {"$ref": "#/$defs/unique_ids"},
    "reservation_ids": {"$ref": "#/$defs/unique_ids"},
    "account_state_id": {"type": "string", "minLength": 1},
    "risk_limit_set_id": {"type": "string", "minLength": 1},
    "market_state_ids": {"$ref": "#/$defs/unique_ids"},
    "model_state_ids": {"$ref": "#/$defs/unique_ids"},
    "strategy_state_id": {"type": "string", "minLength": 1},
    "valuation_time": {"$ref": "#/$defs/timestamp"},
    "decision_time": {"$ref": "#/$defs/timestamp"},
    "available_at": {"$ref": "#/$defs/timestamp"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "base_currency": {"type": "string", "pattern": "^[A-Z0-9]{2,12}$"},
    "nav": {"$ref": "#/$defs/non_negative_number"},
    "cash_total": {"$ref": "#/$defs/non_negative_number"},
    "cash_reserved": {"$ref": "#/$defs/non_negative_number"},
    "cash_available": {"$ref": "#/$defs/non_negative_number"},
    "gross_exposure": {"$ref": "#/$defs/non_negative_number"},
    "net_exposure": {"type": "number"},
    "portfolio_risk": {"$ref": "#/$defs/non_negative_number"},
    "reserved_risk": {"$ref": "#/$defs/non_negative_number"},
    "portfolio_heat": {"$ref": "#/$defs/non_negative_number"},
    "drawdown": {"type": "number", "minimum": 0, "maximum": 1},
    "reconciliation_state": {"enum": ["RECONCILED", "UNKNOWN", "DIVERGENT", "FROZEN"]},
    "data_quality_state": {"enum": ["VALID", "DEGRADED", "STALE", "UNKNOWN", "INVALID"]},
    "runtime_mode": {"type": "string", "minLength": 1},
    "validation_state": {"enum": ["VALID", "BLOCKED", "UNKNOWN", "INVALID"]},
    "lineage_id": {"type": "string", "minLength": 1},
    "state_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "non_negative_number": {"type": "number", "minimum": 0},
    "unique_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
