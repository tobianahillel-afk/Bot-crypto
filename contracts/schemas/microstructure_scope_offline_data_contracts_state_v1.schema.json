      "schema_version": {"const": "lot37-lineage-envelope-v1"}, "lineage_id": {"type": "string", "minLength": 1}, "entry_gate_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "v3_post_merge_audit_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "lot36_state_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "lot36_audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "l2_fixture_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "trade_fixture_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "available_at": {"type": "string", "minLength": 1}
    }},
    "event_time": {"type": "string", "minLength": 1},
    "available_at": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "validation_state": {"const": "VALIDATED_OFFLINE_CONTRACT_SCOPE"},
    "contract_registry": {"type": "object", "required": ["schema_version", "registry_id", "registry_version", "entries"]},
    "capability_matrix": {"type": "object", "required": ["schema_version", "matrix_id", "matrix_version", "entries"]},
    "public_api": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["schema_version", "symbol", "module", "kind", "status"], "properties": {
      "schema_version": {"const": "lot37-public-api-entry-v1"}, "symbol": {"type": "string", "minLength": 1}, "module": {"type": "string", "pattern": "^crypto_quant_bot\\.microstructure"}, "kind": {"enum": ["FUNCTION", "CONTRACT"]}, "status": {"const": "ACTIVE_LOT37_API"}
    }}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["schema_version", "lot_37_contracts_total", "lot_37_capabilities_total", "lot_37_required_capabilities_total", "lot_37_disabled_capabilities_total", "lot_37_forbidden_capabilities_total", "lot_37_public_api_symbols_total", "lot_37_offline_fixture_total", "lot_37_validation_failures_total", "lot_37_processing_latency_us"], "properties": {
      "schema_version": {"const": "lot37-metrics-v1"}, "lot_37_contracts_total": {"type": "integer", "minimum": 0}, "lot_37_capabilities_total": {"type": "integer", "minimum": 0}, "lot_37_required_capabilities_total": {"type": "integer", "minimum": 0}, "lot_37_disabled_capabilities_total": {"type": "integer", "minimum": 0}, "lot_37_forbidden_capabilities_total": {"type": "integer", "minimum": 0}, "lot_37_public_api_symbols_total": {"type": "integer", "minimum": 0}, "lot_37_offline_fixture_total": {"type": "integer", "minimum": 0}, "lot_37_validation_failures_total": {"type": "integer", "minimum": 0}, "lot_37_processing_latency_us": {"type": "integer", "minimum": 0}
    }},
