{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "microstructure_scope_offline_data_contracts_state_v1.schema.json",
  "title": "MicrostructureScopeOfflineDataContractsStateV1",
  "type": "object",
