{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "microstructure_offline_l2_input_v1.schema.json",
  "title": "MicrostructureOfflineL2InputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "fixture_only", "canonical_contract", "source_id", "venue", "instrument_id", "market_type", "event_time", "available_at", "sequence_id", "bids", "asks", "reason_codes", "used_for_decision"],
  "properties": {
    "schema_version": {"const": "lot37-offline-l2-availability-fixture-v1"},
    "fixture_id": {"type": "string", "minLength": 1},
    "fixture_only": {"const": true},
    "canonical_contract": {"const": false},
    "source_id": {"type": "string", "minLength": 1},
    "venue": {"type": "string", "minLength": 1},
    "instrument_id": {"type": "string", "minLength": 1},
    "market_type": {"const": "SPOT"},
    "event_time": {"type": "string", "minLength": 1},
    "available_at": {"type": "string", "minLength": 1},
    "sequence_id": {"type": "integer", "minimum": 0},
    "bids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/level"}},
    "asks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/level"}},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "used_for_decision": {"const": false}
  },
  "$defs": {
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "quantity"],
      "properties": {
        "price": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "quantity": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}
      }
    }
  }
}
