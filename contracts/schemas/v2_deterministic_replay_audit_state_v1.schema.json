{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_checksum": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_path": {
          "pattern": "^data/audit/",
          "type": "string"
        },
        "byte_size": {
          "minimum": 1,
          "type": "integer"
        },
        "embedded_output_checksum": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "lot": {
          "maximum": 28,
          "minimum": 21,
          "type": "integer"
        },
        "schema_version": {
          "const": "artifact-replay-evidence-v1"
        },
        "validation_state": {
          "const": "VALIDATED"
        }
      },
      "required": [
        "schema_version",
        "lot",
        "artifact_path",
        "artifact_checksum",
        "byte_size",
        "embedded_output_checksum",
        "validation_state"
      ],
      "type": "object"
    },
    "closure": {
      "additionalProperties": false,
      "properties": {
        "artifact_checksums": {
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "artifact_count": {
          "const": 8
        },
        "chain_checksum": {
          "$ref": "#/$defs/sha256"
        },
        "closure_status": {
          "const": "V2_REPLAY_VALIDATED_OFFLINE_ONLY"
        },
        "lot_sequence": {
          "items": false,
          "maxItems": 8,
          "minItems": 8,
          "prefixItems": [
            {
              "const": 21
            },
            {
              "const": 22
            },
            {
              "const": 23
            },
            {
              "const": 24
            },
            {
              "const": 25
            },
            {
              "const": 26
            },
            {
              "const": 27
            },
            {
              "const": 28
            }
          ],
          "type": "array"
        },
        "schema_version": {
          "const": "v2-closure-manifest-v1"
        },
        "validator_count": {
          "const": 8
        }
      },
      "required": [
        "schema_version",
        "lot_sequence",
        "artifact_checksums",
        "chain_checksum",
        "validator_count",
        "artifact_count",
        "closure_status"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "validator": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "type": "array"
        },
        "lot": {
          "maximum": 28,
          "minimum": 21,
          "type": "integer"
        },
        "return_code": {
          "const": 0
        },
        "schema_version": {
          "const": "validator-replay-evidence-v1"
        },
        "status": {
          "const": "PASS"
        },
        "stdout_checksum": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "schema_version",
        "lot",
        "command",
        "return_code",
        "status",
        "stdout_checksum"
      ],
      "type": "object"
    }
  },
  "$id": "https://crypto-quant-bot.local/contracts/v2_deterministic_replay_audit_state_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_only": {
      "const": true
    },
    "approved_size": {
      "const": 0
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "maxItems": 8,
      "minItems": 8,
      "type": "array"
    },
    "closure_manifest": {
      "$ref": "#/$defs/closure"
    },
    "code_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "execution_allowed": {
      "const": false
    },
    "output_checksum": {
      "$ref": "#/$defs/sha256"
    },
    "reason_codes": {
      "items": false,
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "const": "V2_ARTIFACT_CHAIN_MATCH"
        },
        {
          "const": "V2_VALIDATORS_PASS"
        },
        {
          "const": "V2_OFFLINE_ONLY"
        }
      ],
      "type": "array"
    },
    "replay_status": {
      "const": "MATCH"
    },
    "runtime_mode": {
      "const": "LOCAL_OFFLINE_ANALYSIS_ONLY"
    },
    "schema_version": {
      "const": "v2-deterministic-replay-audit-state-v1"
    },
    "trade_allowed": {
      "const": false
    },
    "used_for_decision": {
      "const": false
    },
    "validators": {
      "items": {
        "$ref": "#/$defs/validator"
      },
      "maxItems": 8,
      "minItems": 8,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "code_commit",
    "runtime_mode",
    "artifacts",
    "validators",
    "closure_manifest",
    "replay_status",
    "reason_codes",
    "analysis_only",
    "used_for_decision",
    "trade_allowed",
    "execution_allowed",
    "approved_size",
    "output_checksum"
  ],
  "title": "V2DeterministicReplayAuditStateV1",
  "type": "object"
}
