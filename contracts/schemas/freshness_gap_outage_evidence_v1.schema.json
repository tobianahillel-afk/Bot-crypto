{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "freshness_gap_outage_evidence_v1.schema.json",
  "title": "FreshnessGapOutageEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "instrument_id", "timeframe", "record_count", "expected_interval_count", "observed_interval_count", "missing_interval_count", "gap_count", "outage_count", "stale_record_count", "latest_event_time", "latest_available_at", "reference_time", "freshness_age_us", "max_staleness_us", "freshness_bps", "status", "reason_codes"],
  "properties": {
    "schema_version": {"const": "freshness-gap-outage-evidence-v1"},
    "source_id": {"type": "string", "minLength": 1},
    "instrument_id": {"type": "string", "minLength": 1},
    "timeframe": {"type": "string", "minLength": 1},
    "record_count": {"type": "integer", "minimum": 0},
    "expected_interval_count": {"type": "integer", "minimum": 0},
    "observed_interval_count": {"type": "integer", "minimum": 0},
    "missing_interval_count": {"type": "integer", "minimum": 0},
    "gap_count": {"type": "integer", "minimum": 0},
    "outage_count": {"type": "integer", "minimum": 0},
    "stale_record_count": {"type": "integer", "minimum": 0},
    "latest_event_time": {"type": "string"},
    "latest_available_at": {"type": "string"},
    "reference_time": {"type": "string"},
    "freshness_age_us": {"type": "integer", "minimum": 0},
    "max_staleness_us": {"type": "integer", "minimum": 0},
    "freshness_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "status": {"enum": ["PASS", "BLOCKED", "UNKNOWN"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
