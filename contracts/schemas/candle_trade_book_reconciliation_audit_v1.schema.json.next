{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candle_trade_book_reconciliation_audit_v1.schema.json",
  "title": "CandleTradeBookReconciliationAuditV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "code_commit", "state_output_checksum", "config_checksum",
    "lot34_state_checksum", "lot34_audit_checksum", "report_count", "match_count",
    "tolerated_diff_count", "minor_divergence_count", "critical_divergence_count",
    "veto_action", "lineage_id", "event_time", "available_at", "generated_at",
    "validation_state", "reason_codes", "analysis_only", "used_for_decision",
    "external_connectivity_allowed", "network_ingestion_allowed", "real_credentials_allowed",
    "market_event_publication_allowed", "raw_data_mutation_allowed", "signal_generation_allowed",
    "risk_approval_allowed", "order_routing_allowed", "trade_allowed", "execution_allowed",
    "approved_size", "audit_checksum"
  ],
  "properties": {
    "schema_version": {"const": "candle-trade-book-reconciliation-audit-v1"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "state_output_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot34_state_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lot34_audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_count": {"type": "integer", "minimum": 0},
    "match_count": {"type": "integer", "minimum": 0},
    "tolerated_diff_count": {"type": "integer", "minimum": 0},
    "minor_divergence_count": {"type": "integer", "minimum": 0},
    "critical_divergence_count": {"type": "integer", "minimum": 0},
    "veto_action": {"enum": ["ALLOW_ANALYSIS", "PAUSE", "KILL_SWITCH"]},
    "lineage_id": {"type": "string", "minLength": 1},
    "event_time": {"type": "string", "pattern": "Z$"},
    "available_at": {"type": "string", "pattern": "Z$"},
    "generated_at": {"type": "string", "pattern": "Z$"},
    "validation_state": {"enum": ["VALIDATED_RECONCILIATION_ONLY", "BLOCKED_RECONCILIATION"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "analysis_only": {"const": true},
    "used_for_decision": {"const": false},
    "external_connectivity_allowed": {"const": false},
    "network_ingestion_allowed": {"const": false},
    "real_credentials_allowed": {"const": false},
    "market_event_publication_allowed": {"const": false},
    "raw_data_mutation_allowed": {"const": false},
    "signal_generation_allowed": {"const": false},
    "risk_approval_allowed": {"const": false},
    "order_routing_allowed": {"const": false},
    "trade_allowed": {"const": false},
    "execution_allowed": {"const": false},
    "approved_size": {"const": 0},
    "audit_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
