{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant-bot.local/schemas/liquidity_exit_zone_v1.schema.json",
  "title": "LiquidityExitZoneV1",
  "description": "Planned inferred liquidity/exit-zone contract owned by V4. Not implemented in Lot 26.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "zone_id",
    "instrument_id",
    "price_lower",
    "price_upper",
    "zone_type",
    "participant_classes",
    "forecast_horizons",
    "construction_method",
    "evidence_refs",
    "counter_evidence_refs",
    "score",
    "calibrated_probability",
    "uncertainty",
    "first_observed_at",
    "last_updated_at",
    "available_at",
    "invalidation_conditions",
    "lineage_id",
    "validation_state"
  ],
  "properties": {
    "schema_version": {"const": "liquidity-exit-zone-v1"},
    "zone_id": {"type": "string", "minLength": 1},
    "instrument_id": {"type": "string", "minLength": 1},
    "price_lower": {"type": "number", "exclusiveMinimum": 0},
    "price_upper": {"type": "number", "exclusiveMinimum": 0},
    "zone_type": {
      "enum": [
        "STOP_LOSS_CLUSTER",
        "TAKE_PROFIT_CLUSTER",
        "BREAK_EVEN_CLUSTER",
        "LIQUIDATION_CLUSTER",
        "ENTRY_CONGESTION_ZONE",
        "TRAPPED_POSITION_ZONE",
        "FORCED_EXIT_ZONE",
        "PASSIVE_DEFENSE_ZONE"
      ]
    },
    "participant_classes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "forecast_horizons": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "construction_method": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "counter_evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "calibrated_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "calibration_id": {"type": ["string", "null"]},
    "uncertainty": {"type": ["object", "null"]},
    "first_observed_at": {"type": "string", "format": "date-time"},
    "last_updated_at": {"type": "string", "format": "date-time"},
    "available_at": {"type": "string", "format": "date-time"},
    "invalidation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "lineage_id": {"type": "string", "minLength": 1},
    "validation_state": {"enum": ["VALID", "DEGRADED", "UNKNOWN", "BLOCKED"]},
    "inferred_not_observed_private_orders": {"const": true},
    "signal_generation_allowed": {"const": false},
    "execution_allowed": {"const": false}
  }
}
