{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant-bot.local/schemas/participant_behavior_scenario_v1.schema.json",
  "title": "ParticipantBehaviorScenarioV1",
  "description": "Planned probabilistic inference contract owned by V4. Not implemented in Lot 26.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "instrument_id",
    "participant_class",
    "information_set",
    "observable_evidence",
    "counter_evidence",
    "constraints",
    "action_set",
    "payoff_proxy",
    "loss_or_pain_proxy",
    "belief_state",
    "best_response_candidates",
    "bounded_rationality_assumptions",
    "forecast_horizon",
    "invalidation_conditions",
    "confidence_proxy",
    "calibrated_probability",
    "available_at",
    "lineage_id",
    "validation_state"
  ],
  "properties": {
    "schema_version": {"const": "participant-behavior-scenario-v1"},
    "scenario_id": {"type": "string", "minLength": 1},
    "instrument_id": {"type": "string", "minLength": 1},
    "participant_class": {
      "enum": [
        "MARKET_MAKER",
        "MOMENTUM_TRADER",
        "MEAN_REVERSION_TRADER",
        "LATE_BREAKOUT_BUYER",
        "LATE_BREAKOUT_SELLER",
        "LEVERAGED_LONG",
        "LEVERAGED_SHORT",
        "TRAPPED_BUYER",
        "TRAPPED_SELLER",
        "FORCED_LIQUIDATOR",
        "LARGE_PASSIVE_PARTICIPANT",
        "ARBITRAGEUR",
        "PROFIT_TAKER",
        "BREAK_EVEN_DEFENDER",
        "UNKNOWN"
      ]
    },
    "information_set": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "observable_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "counter_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "action_set": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "payoff_proxy": {"type": ["object", "null"]},
    "loss_or_pain_proxy": {"type": ["object", "null"]},
    "belief_state": {"type": ["object", "null"]},
    "best_response_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "bounded_rationality_assumptions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "forecast_horizon": {"type": "string", "minLength": 1},
    "invalidation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "confidence_proxy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "calibrated_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "calibration_id": {"type": ["string", "null"]},
    "available_at": {"type": "string", "format": "date-time"},
    "lineage_id": {"type": "string", "minLength": 1},
    "validation_state": {"enum": ["VALID", "DEGRADED", "UNKNOWN", "BLOCKED"]},
    "inference_explicitly_labeled": {"const": true},
    "signal_generation_allowed": {"const": false},
    "execution_allowed": {"const": false}
  }
}
