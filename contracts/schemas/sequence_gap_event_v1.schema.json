{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sequence_gap_event_v1.schema.json",
  "title": "SequenceGapEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gap_detected",
    "synchronization_state",
    "expected_sequence",
    "observed_sequence",
    "observed_prev_sequence",
    "event_time",
    "reason_codes",
    "event_checksum"
  ],
  "properties": {
    "schema_version": {"const": "sequence-gap-event-v1"},
    "gap_detected": {"type": "boolean"},
    "synchronization_state": {"enum": ["SYNCED", "RESYNC_REQUIRED"]},
    "expected_sequence": {"type": "integer", "minimum": 0},
    "observed_sequence": {
      "oneOf": [
        {"type": "null"},
        {"type": "integer", "minimum": 0}
      ]
    },
    "observed_prev_sequence": {
      "oneOf": [
        {"type": "null"},
        {"type": "integer", "minimum": 0}
      ]
    },
    "event_time": {"type": "string", "minLength": 1},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "event_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
