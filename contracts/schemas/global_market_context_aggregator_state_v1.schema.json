{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant-bot.local/schemas/global-market-context-aggregator-state-v1.schema.json",
  "title": "global-market-context-aggregator-state-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "instrument_id",
    "decision_time",
    "dominant_state",
    "alternative_states",
    "category_support",
    "aggregate_evidence_score",
    "weighted_coverage_ratio",
    "available_source_count",
    "missing_source_weight",
    "conflict_states",
    "confidence_interval",
    "contributions",
    "lineage_id",
    "config_version",
    "config_checksum",
    "code_commit",
    "output_checksum",
    "reason_codes",
    "validation_state",
    "analysis_only",
    "used_for_decision",
    "forecast_generation_allowed",
    "probability_claims_allowed",
    "signal_generation_allowed",
    "order_routing_allowed",
    "execution_allowed",
    "trade_allowed",
    "approved_size"
  ],
  "properties": {
    "schema_version": {"const": "global-market-context-aggregator-state-v1"},
    "context_id": {"type": "string", "minLength": 1},
    "instrument_id": {"const": "BTC/EUR"},
    "decision_time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "dominant_state": {"enum": ["GLOBAL_CONTEXT_TRENDING", "GLOBAL_CONTEXT_RANGE", "GLOBAL_CONTEXT_MIXED", "GLOBAL_CONTEXT_UNKNOWN"]},
    "alternative_states": {"type": "array", "uniqueItems": true, "items": {"enum": ["TRENDING", "RANGE", "MIXED", "CONFLICT"]}},
    "category_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["TRENDING", "RANGE", "MIXED", "CONFLICT"],
      "properties": {
        "TRENDING": {"type": "number", "minimum": 0, "maximum": 1},
        "RANGE": {"type": "number", "minimum": 0, "maximum": 1},
        "MIXED": {"type": "number", "minimum": 0, "maximum": 1},
        "CONFLICT": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "aggregate_evidence_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "weighted_coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "available_source_count": {"type": "integer", "minimum": 0, "maximum": 5},
    "missing_source_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "conflict_states": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "confidence_interval": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["lower", "upper"], "properties": {"lower": {"type": "number", "minimum": 0, "maximum": 1}, "upper": {"type": "number", "minimum": 0, "maximum": 1}}}]},
    "contributions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "source_id", "source_schema_version", "source_artifact", "source_checksum", "source_state", "semantic_category", "source_score", "configured_weight", "effective_contribution", "quality_state", "event_time", "age_seconds", "included", "reason_codes"],
        "properties": {
          "schema_version": {"const": "global-context-source-contribution-v1"},
          "source_id": {"enum": ["lot22_market_analysis", "lot23_technical_indicators", "lot24_trend_range_momentum", "lot25_volatility_regime_confluence", "lot26_multi_timeframe_alignment"]},
          "source_schema_version": {"type": ["string", "null"]},
          "source_artifact": {"type": "string", "minLength": 1},
          "source_checksum": {"type": ["string", "null"]},
          "source_state": {"type": ["string", "null"]},
          "semantic_category": {"type": ["string", "null"]},
          "source_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "configured_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "effective_contribution": {"type": "number", "minimum": 0, "maximum": 1},
          "quality_state": {"enum": ["VALID", "MISSING", "INVALID", "STALE"]},
          "event_time": {"type": ["string", "null"]},
          "age_seconds": {"type": ["number", "null"], "minimum": 0},
          "included": {"type": "boolean"},
          "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "lineage_id": {"type": "string", "minLength": 1},
    "config_version": {"type": "string", "minLength": 1},
    "config_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "code_commit": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
    "output_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "validation_state": {"enum": ["VALID", "UNKNOWN", "BLOCKED"]},
    "analysis_only": {"const": true},
    "used_for_decision": {"const": false},
    "forecast_generation_allowed": {"const": false},
    "probability_claims_allowed": {"const": false},
    "signal_generation_allowed": {"const": false},
    "order_routing_allowed": {"const": false},
    "execution_allowed": {"const": false},
    "trade_allowed": {"const": false},
    "approved_size": {"const": 0}
  }
}
