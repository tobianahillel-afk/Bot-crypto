{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cvd_series_v1.schema.json",
  "title": "CVDSeriesV1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "market_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_id", "venue", "instrument_id", "market_type"],
      "properties": {
        "schema_version": {"const": "lot45-market-identity-v1"},
        "source_id": {"type": "string", "minLength": 1},
        "venue": {"type": "string", "minLength": 1},
        "instrument_id": {"type": "string", "minLength": 1},
        "market_type": {"type": "string", "minLength": 1}
      }
    }
  },
  "required": ["schema_version", "market_identity", "session_policy_version", "points", "cvd_checksum"],
  "properties": {
    "schema_version": {"const": "cvd-series-v1"},
    "market_identity": {"$ref": "#/$defs/market_identity"},
    "session_policy_version": {"const": "lot45-utc-day-session-v1"},
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "event_time", "session_id", "window_checksum", "signed_delta", "cvd"],
        "properties": {
          "schema_version": {"const": "cvd-point-v1"},
          "event_time": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)(?!9999-12-31T23:59:59\\.)(?:(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"},
          "session_id": {"type": "string", "minLength": 1},
          "window_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "signed_delta": {"type": "string", "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$"},
          "cvd": {"type": "string", "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$"}
        }
      }
    },
    "cvd_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
