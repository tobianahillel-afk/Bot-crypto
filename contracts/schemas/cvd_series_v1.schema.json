{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cvd_series_v1.schema.json",
  "title": "CVDSeriesV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_policy_version", "points", "cvd_checksum"],
  "properties": {
    "schema_version": {"const": "cvd-series-v1"},
    "session_policy_version": {"const": "lot45-utc-day-session-v1"},
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "event_time", "session_id", "window_checksum", "signed_delta", "cvd"],
        "properties": {
          "schema_version": {"const": "cvd-point-v1"},
          "event_time": {"type": "string", "pattern": "Z$"},
          "session_id": {"type": "string", "minLength": 1},
          "window_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "signed_delta": {"type": "string"},
          "cvd": {"type": "string"}
        }
      }
    },
    "cvd_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
