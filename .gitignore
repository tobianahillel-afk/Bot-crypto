.env
*.key
*.pem
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Data is ignored by default because raw data can become large or sensitive.
data/raw/*
data/bronze/*
data/silver/*
data/gold/*
data/audit/*
!data/raw/.gitkeep
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
!data/audit/.gitkeep
!data/raw/fixtures/
!data/raw/fixtures/*.csv
!data/audit/dataset_catalog.json
!data/audit/lot_01_data_quality_report.json

reports/*.json
!reports/lot_00_validation_report.md
!reports/lot_01_validation_report.md
!reports/lot_01_data_quality_report.md
