{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tobianahillel-afk/Bot-crypto/config/governance/agent_work_unit_v1.schema.json",
  "title": "Crypto Quant Bot Agent Work Unit V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "status",
    "parent",
    "title",
    "objective",
    "non_goals",
    "depends_on",
    "inputs",
    "outputs",
    "scope",
    "contracts",
    "planning",
    "validation",
    "done_when"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "agent_work_unit"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]*(?:[.-][A-Z0-9_-]+)*-WU[0-9]{2,}$"
    },
    "status": {
      "enum": [
        "PLANNED",
        "READY",
        "IN_PROGRESS",
        "BLOCKED",
        "DONE"
      ]
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_item_id",
        "task_id",
        "manifest"
      ],
      "properties": {
        "work_item_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*(?:[.-][A-Z0-9_-]+)*$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*(?:[.-][A-Z0-9_-]+)*$"
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]*(?:[.-][A-Z0-9_-]+)*-WU[0-9]{2,}$"
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_base_sha",
        "allowed_paths",
        "forbidden_paths",
        "forbidden_semantics"
      ],
      "properties": {
        "scope_base_sha": {
          "$ref": "#/$defs/sha40"
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_semantics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_invariants",
        "acceptance_criteria"
      ],
      "properties": {
        "required_invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_class",
        "complexity_factors",
        "complexity_score",
        "size_estimate",
        "split_required",
        "split_reasons",
        "context_budget"
      ],
      "properties": {
        "risk_class": {
          "enum": [
            "UNCLASSIFIED",
            "R0",
            "R1",
            "R2",
            "R3"
          ]
        },
        "complexity_score": {
          "type": "integer",
          "minimum": 0
        },
        "split_required": {
          "type": "boolean"
        },
        "context_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_primary_files",
            "max_reference_files",
            "max_total_kib"
          ],
          "properties": {
            "max_primary_files": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "max_reference_files": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "max_total_kib": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "complexity_factors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "production_modules",
            "contract_schema_families",
            "policy_config_families",
            "persistence_checksum_boundary",
            "math_numeric_semantics",
            "temporal_lineage_semantics",
            "cross_domain_interfaces",
            "state_machine_or_concurrency",
            "security_trust_boundary",
            "risk_execution_permission",
            "dependency_change",
            "ci_evidence_topology_change"
          ],
          "properties": {
            "production_modules": {
              "type": "integer",
              "minimum": 0
            },
            "contract_schema_families": {
              "type": "integer",
              "minimum": 0
            },
            "policy_config_families": {
              "type": "integer",
              "minimum": 0
            },
            "persistence_checksum_boundary": {
              "type": "boolean"
            },
            "math_numeric_semantics": {
              "type": "boolean"
            },
            "temporal_lineage_semantics": {
              "type": "boolean"
            },
            "cross_domain_interfaces": {
              "type": "integer",
              "minimum": 0
            },
            "state_machine_or_concurrency": {
              "type": "boolean"
            },
            "security_trust_boundary": {
              "type": "boolean"
            },
            "risk_execution_permission": {
              "type": "boolean"
            },
            "dependency_change": {
              "type": "boolean"
            },
            "ci_evidence_topology_change": {
              "type": "boolean"
            }
          }
        },
        "size_estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "business_domains",
            "files_touched",
            "executable_loc_changed",
            "new_public_behaviors",
            "contract_families",
            "independent_algorithms",
            "state_machines",
            "trust_boundaries",
            "new_dependencies"
          ],
          "properties": {
            "business_domains": {
              "type": "integer",
              "minimum": 1
            },
            "files_touched": {
              "type": "integer",
              "minimum": 1
            },
            "executable_loc_changed": {
              "type": "integer",
              "minimum": 0
            },
            "new_public_behaviors": {
              "type": "integer",
              "minimum": 0
            },
            "contract_families": {
              "type": "integer",
              "minimum": 0
            },
            "independent_algorithms": {
              "type": "integer",
              "minimum": 0
            },
            "state_machines": {
              "type": "integer",
              "minimum": 0
            },
            "trust_boundaries": {
              "type": "integer",
              "minimum": 0
            },
            "new_dependencies": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "split_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_tiers",
        "target_commands"
      ],
      "properties": {
        "required_tiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "T0",
              "T1",
              "T2",
              "T3",
              "T4"
            ]
          }
        },
        "target_commands": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "done_when": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "locator"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "FILE",
            "SCHEMA",
            "CONFIG",
            "CONTRACT",
            "TEST",
            "EVIDENCE",
            "STATE",
            "API",
            "OTHER"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
