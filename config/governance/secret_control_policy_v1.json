{
  "schema_version": 1,
  "policy_kind": "secret_control_policy_v1",
  "semantics": "PINNED_MIT_GITLEAKS_REDACTED_FAIL_CLOSED",
  "workflow_path": ".github/workflows/security-secrets.yml",
  "gitleaks": {
    "repository": "https://github.com/gitleaks/gitleaks.git",
    "tag": "v8.30.1",
    "commit": "83d9cd684c87d95d656c1458ef04895a7f1cbd8e",
    "version": "8.30.1",
    "license": "MIT"
  },
  "toolchain": {
    "go_version": "1.24.11",
    "checkout_action_sha": "3d3c42e5aac5ba805825da76410c181273ba90b1",
    "checkout_version_comment": "v7.0.1",
    "setup_go_action_sha": "b7ad1dad31e06c5925ef5d2fc7ad053ef454303e",
    "setup_go_version_comment": "v7.0.0"
  },
  "required_scans": [
    "SYNTHETIC_POSITIVE_CONTROL",
    "CURRENT_TREE",
    "FULL_GIT_HISTORY"
  ],
  "required_redaction_percent": 100,
  "max_scan_timeout_seconds": 120,
  "forbidden_tokens": [
    "gitleaks/gitleaks-action",
    "GITLEAKS_LICENSE",
    "permissions: write-all",
    "contents: write",
    "pull-requests: write",
    "security-events: write"
  ],
  "cost_policy": {
    "paid_license_required": false,
    "paid_api_required": false,
    "paid_saas_required": false,
    "paid_runner_required": false
  },
  "invariants": [
    "Gitleaks CLI source tag and commit are both verified before build",
    "Go and GitHub setup actions are exact-version pinned",
    "workflow token permissions are read-only",
    "all scanner output is fully redacted",
    "synthetic positive control exists only at runtime and is deleted",
    "default Gitleaks rules remain enabled",
    "current tree and full Git history are scanned",
    "no allowlist or paid license dependency is accepted by default"
  ]
}
