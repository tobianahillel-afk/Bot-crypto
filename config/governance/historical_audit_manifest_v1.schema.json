{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crypto Quant Bot Historical Audit Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "manifest_id",
    "manifest_identity_sha256",
    "status",
    "mode",
    "plan_identity_sha256",
    "batch_identity_sha256",
    "batch_index",
    "lots",
    "complexity_total",
    "isolated_oversized",
    "source_binding",
    "permissions",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest_kind": {
      "const": "historical_audit_manifest_v1"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^HIST-AUDIT-BATCH-[0-9]{3}$"
    },
    "manifest_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "PLANNED",
        "READY",
        "IN_PROGRESS",
        "REVIEW_REQUIRED",
        "COMPLETE",
        "BLOCKED"
      ]
    },
    "mode": {
      "const": "READ_ONLY"
    },
    "plan_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "batch_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "batch_index": {
      "type": "integer",
      "minimum": 1
    },
    "lots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 44
      }
    },
    "complexity_total": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "isolated_oversized": {
      "type": "boolean"
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "certified_baseline_lot",
        "certified_baseline_verdict",
        "source_head_sha"
      ],
      "properties": {
        "repository": {
          "const": "tobianahillel-afk/Bot-crypto"
        },
        "certified_baseline_lot": {
          "const": 44
        },
        "certified_baseline_verdict": {
          "const": "GO_LOT44_POST_MERGE"
        },
        "source_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_evidence_write",
        "business_code_write",
        "remediation_write",
        "runtime_mutation"
      ],
      "properties": {
        "historical_evidence_write": {
          "const": false
        },
        "business_code_write": {
          "const": false
        },
        "remediation_write": {
          "const": false
        },
        "runtime_mutation": {
          "const": false
        }
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
